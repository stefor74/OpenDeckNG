{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBuildCommand": "deno task build",
		"beforeDevCommand": "deno task dev",
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": { "target/plugins/": "plugins/" },
		"linux": {
			"deb": {
				"desktopTemplate": "bundle/opendeckng.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/opendeckng.metainfo.xml": "bundle/opendeckng.metainfo.xml"
				}
			},
			"rpm": {
				"desktopTemplate": "bundle/opendeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/opendeckng.metainfo.xml": "bundle/opendeckng.metainfo.xml"
				}
			}
		},
		"publisher": "Stefan Forster (stefor74)",
		"shortDescription": "Next-gen stream controller for Linux",
		"longDescription": "OpenDeckNG is a community-driven Linux-focused fork of OpenDeck. It brings native Linux desktop integration, GIF animation support, profile backgrounds, and an enhanced starter pack for Linux users running CachyOS, Arch, and Hyprland.",
		"category": "Productivity",
		"icon": [
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"exceptionDomain": "localhost",
			"signingIdentity": "-"
		}
	},
	"productName": "OpenDeckNG",
	"mainBinaryName": "opendeck-ng",
	"identifier": "com.stefor74.opendeckng",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["opendeck", "openaction", "streamdeck"]
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "OpenDeck",
				"fullscreen": false,
				"resizable": true,
				"width": 800,
				"height": 600,
				"minWidth": 800,
				"minHeight": 600,
				"center": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src http://localhost:*; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://openactionapi.github.io https://api.github.com https://raw.githubusercontent.com https://plugins.amankhanna.me;"
		},
		"withGlobalTauri": true
	}
}
