{
	"Name": "OpenDeckNG Linux Pack",
	"Description": "Linux desktop integration for OpenDeckNG",
	"Author": "Stefan Forster (stefor74)",
	"Version": "0.1.0",
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/opendeck-ng-linux",
		"aarch64-unknown-linux-gnu": "aarch64-unknown-linux-gnu/bin/opendeck-ng-linux"
	},
	"CodePathLin": "x86_64-unknown-linux-gnu/bin/opendeck-ng-linux",
	"Icon": "icons/plugin",
	"Category": "OpenDeckNG",
	"OS": [
		{
			"Platform": "linux"
		}
	],
	"Actions": [
		{
			"Icon": "icons/plugin",
			"Name": "Media Control",
			"States": [{ "Image": "actionDefaultImage" }],
			"Controllers": ["Keypad", "Encoder"],
			"SupportedInMultiActions": true,
			"Tooltip": "Control media playback via MPRIS",
			"UUID": "com.stefor74.opendeckng.linux.mediacontrol",
			"PropertyInspectorPath": "propertyInspector/mediaControl.html"
		},
		{
			"Icon": "icons/plugin",
			"Name": "Audio Volume",
			"States": [{ "Image": "actionDefaultImage" }],
			"Controllers": ["Keypad", "Encoder"],
			"SupportedInMultiActions": true,
			"Tooltip": "Control system audio volume",
			"UUID": "com.stefor74.opendeckng.linux.audiovolume",
			"PropertyInspectorPath": "propertyInspector/audioVolume.html"
		},
		{
			"Icon": "icons/plugin",
			"Name": "System Monitor",
			"States": [{ "Image": "actionDefaultImage" }],
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": true,
			"Tooltip": "Show CPU, RAM or network usage",
			"UUID": "com.stefor74.opendeckng.linux.systemmonitor",
			"PropertyInspectorPath": "propertyInspector/systemMonitor.html"
		},
		{
			"Icon": "icons/plugin",
			"Name": "Hyprland Workspace",
			"States": [{ "Image": "actionDefaultImage" }],
			"Controllers": ["Keypad", "Encoder"],
			"SupportedInMultiActions": true,
			"Tooltip": "Switch Hyprland workspaces",
			"UUID": "com.stefor74.opendeckng.linux.hyprlandworkspace",
			"PropertyInspectorPath": "propertyInspector/hyprlandWorkspace.html"
		},
		{
			"Icon": "icons/plugin",
			"Name": "Counter",
			"States": [{ "Image": "actionDefaultImage" }],
			"Controllers": ["Keypad", "Encoder"],
			"SupportedInMultiActions": true,
			"Tooltip": "Increment or decrement a counter",
			"UUID": "com.stefor74.opendeckng.linux.counter",
			"PropertyInspectorPath": "propertyInspector/counter.html"
		}
	]
}
